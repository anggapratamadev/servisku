# TEMPLATE DOKUMENTASI SAJA.
# PHP pada versi ini TIDAK membaca file .env secara otomatis.
# Atur variabel berikut melalui environment sistem / konfigurasi web server.
# Jangan masukkan kredensial asli ke file ini dan jangan commit file .env.

APP_ENV=production
APP_DEBUG=0
APP_BASE_URL=https://your-domain.example

DB_HOST=127.0.0.1
DB_NAME=servisku
DB_USER=servisku_app
DB_PASSWORD=replace-with-a-long-unique-password

# Opsional: diperlukan hanya jika Google OAuth diaktifkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google_callback.php
